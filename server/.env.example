# ============================================================
# AgroThes SGP - Variables de Entorno (EJEMPLO)
# ============================================================
# INSTRUCCIONES:
# 1. Renombra este archivo a ".env"
# 2. Modifica los valores según tu configuración
# 3. NO subas el archivo .env a Git

# Base de datos MySQL
# Formato: mysql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL="mysql://root:TU_CONTRASEÑA@localhost:3306/agrothes"

# Puerto del servidor (por defecto: 3001)
PORT=3001

# Entorno de ejecución (development, production)
NODE_ENV=development

# CORS - URL del frontend (React)
FRONTEND_URL=http://localhost:5173
